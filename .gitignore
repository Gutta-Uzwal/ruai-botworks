__pycache__/
*.py[cod]

# Client project and template build output, for every project/template, not
# just the first one. Shape is <domain>/<project-or-template-name>/backend|frontend.
projects/*/*/backend/.venv/
projects/*/*/backend/*.egg-info/
projects/*/*/backend/db.sqlite3
projects/*/*/frontend/node_modules/
projects/*/*/frontend/dist/
templates/*/*/backend/.venv/
templates/*/*/backend/*.egg-info/
templates/*/*/backend/db.sqlite3
templates/*/*/frontend/node_modules/
templates/*/*/frontend/dist/

# Session-memory plugin state. Machine-local; never company record.
.remember/
.claude/.remember/

# graphify-out/ itself is committed on purpose (README: "meant to be committed
# to git so everyone on the team starts with a map"). Only the per-machine
# cost ledger and the rebuildable extraction cache are local.
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/   # rolling local safety backups before an overwrite

# Receipt chains belong at the repository root and nowhere else. The policy hooks
# write them relative to the current working directory, so any shell that has cd'd
# into a subfolder starts a second, fragmented chain. A chain that splits by working
# directory is not an audit trail. Ignore every nested one at any depth; keep the pair
# at the root, which is the real one.
receipts/
review-receipts/
!/receipts/
!/review-receipts/
